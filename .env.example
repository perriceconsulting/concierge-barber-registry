# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Concierge Barber Registry"
NODE_ENV=development

# Database (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
JWT_ACCESS_SECRET="generate-with-openssl-rand-base64-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-base64-32"

# OAuth - Google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OAuth - Apple
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@conciergebarberregistry.com"

# File Storage - Vercel Blob (Recommended)
BLOB_READ_WRITE_TOKEN=""

# Alternative: Cloudinary
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Maps (Google Maps)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_KEY=""

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Error Tracking (Sentry)
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Rate Limiting (Upstash Redis - Optional)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Stripe
#
# Price ids are NOT authored here — Stripe owns them. Create the products with
# `npx tsx scripts/setup-stripe-products.ts` (idempotent, looks up by
# lookup_key) and paste the ids it prints. Then run
# `npx tsx scripts/verify-stripe-env.ts` to confirm every id actually resolves
# in the account the key belongs to; drift between the two is silent otherwise.
#
# Test and live are separate ACCOUNTS, not two modes of one. Ids minted in the
# sandbox never resolve with a live key and vice versa.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Required — the approval flow creates the Verified Member trial from these.
# Missing means approval still succeeds but no subscription is created and the
# barber is never billed. It fails quietly.
STRIPE_PRICE_VERIFIED_MONTHLY=""
STRIPE_PRICE_VERIFIED_ANNUAL=""

# Optional. Created by the setup script for parity but read by no application
# code: the setup fee is built inline via price_data from VETTING_FEE_PRICING
# in src/lib/copy/v2.ts, so the amount lives in the codebase, not in Stripe.
STRIPE_PRICE_SETUP_INTRO=""
STRIPE_PRICE_SETUP_STANDARD=""
STRIPE_PRICE_SETUP_EXPEDITED=""

# Unused. No @stripe/stripe-js dependency and no client-side Stripe anywhere;
# checkout is created server-side and the user is redirected to session.url.
# Keep only if client-side Stripe is ever introduced.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Retired with the v1 pricing ladder (Professional / Elite). Left here as a
# marker so nobody re-adds them: v2 sells a single Verified Member tier.
# STRIPE_PRICE_PRO_MONTHLY=""
# STRIPE_PRICE_PRO_ANNUAL=""
# STRIPE_PRICE_ELITE_MONTHLY=""
# STRIPE_PRICE_ELITE_ANNUAL=""
