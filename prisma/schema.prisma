generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String              @unique @db.VarChar(255)
  passwordHash          String?             @map("password_hash") @db.VarChar(255)
  role                  UserRole            @default(client)
  firstName             String              @map("first_name") @db.VarChar(100)
  lastName              String              @map("last_name") @db.VarChar(100)
  phone                 String?             @db.VarChar(20)
  avatarUrl             String?             @map("avatar_url")
  emailVerified         Boolean             @default(false) @map("email_verified")
  isActive              Boolean             @default(true) @map("is_active")
  notifyEmailEnabled    Boolean             @default(true) @map("notify_email_enabled")
  notifyContactRequests Boolean             @default(true) @map("notify_contact_requests")
  notifyNewReviews      Boolean             @default(true) @map("notify_new_reviews")
  notifyMarketingEmails Boolean             @default(false) @map("notify_marketing_emails")
  agreedToTermsAt       DateTime?           @map("agreed_to_terms_at")
  isStub                Boolean             @default(false) @map("is_stub")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  auditLogs             AuditLog[]
  barberProfile         BarberProfile?      @relation("BarberToUser")
  verifiedProfiles      BarberProfile[]     @relation("VerifiedBy")
  suspendedProfiles     BarberProfile[]     @relation("SuspendedBy")
  reviewedAppeals       SuspensionAppeal[]  @relation("AppealReviewedBy")
  contactRequests       ContactRequest[]
  favorites             Favorite[]
  reviews               Review[]
  sessions              Session[]
  verificationTokens    VerificationToken[]
  groomingPassport      GroomingPassport?
  outreachNotesAuthored OutreachNote[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  userAgent        String?  @map("user_agent")
  ipAddress        String?  @map("ip_address") @db.VarChar(45)
  expiresAt        DateTime @map("expires_at")
  isRevoked        Boolean  @default(false) @map("is_revoked")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([userId, isRevoked, expiresAt]) // Composite index for active sessions query
  @@map("sessions")
}

model VerificationToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token     String   @unique @db.VarChar(255)
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@index([userId, type, expiresAt]) // Composite index for token verification query
  @@map("verification_tokens")
}

model BarberProfile {
  id                         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                     String             @unique @map("user_id") @db.Uuid
  displayName                String             @map("display_name") @db.VarChar(150)
  slug                       String             @unique @db.VarChar(150)
  bio                        String?
  tagline                    String?            @db.VarChar(255)
  yearsExperience            Int?               @map("years_experience")
  licenseNumber              String?            @map("license_number") @db.VarChar(100)
  licenseState               String?            @map("license_state") @db.VarChar(2)
  licenseExpirationDate      DateTime?          @map("license_expiration_date") @db.Date
  licenseDocumentUrl         String?            @map("license_document_url")
  licenseVerified            Boolean            @default(false) @map("license_verified")
  verificationStatus         VerificationStatus @default(pending) @map("verification_status")
  verificationNotes          String?            @map("verification_notes")
  isHidden                   Boolean            @default(false) @map("is_hidden")
  vacationMode               Boolean            @default(false) @map("vacation_mode")
  verifiedAt                 DateTime?          @map("verified_at")
  verifiedByUserId           String?            @map("verified_by_user_id") @db.Uuid
  submittedForVerificationAt DateTime?          @map("submitted_for_verification_at")
  shopName                   String?            @map("shop_name") @db.VarChar(200)
  shopAddressLine1           String?            @map("shop_address_line1") @db.VarChar(255)
  shopAddressLine2           String?            @map("shop_address_line2") @db.VarChar(255)
  city                       String             @db.VarChar(100)
  state                      String             @db.VarChar(2)
  zipCode                    String             @map("zip_code") @db.VarChar(10)
  latitude                   Decimal?           @db.Decimal(10, 8)
  longitude                  Decimal?           @db.Decimal(11, 8)
  offersMobileService        Boolean            @default(false) @map("offers_mobile_service")
  mobileServiceRadiusMiles   Int?               @map("mobile_service_radius_miles")
  websiteUrl                 String?            @map("website_url")
  instagramHandle            String?            @map("instagram_handle") @db.VarChar(100)
  tiktokHandle               String?            @map("tiktok_handle") @db.VarChar(100)
  acceptsWalkins             Boolean            @default(true) @map("accepts_walkins")
  acceptsAppointments        Boolean            @default(true) @map("accepts_appointments")
  isFeatured                 Boolean            @default(false) @map("is_featured")
  averageRating              Decimal            @default(0.0) @map("average_rating") @db.Decimal(2, 1)
  totalReviews               Int                @default(0) @map("total_reviews")
  profileViews               Int                @default(0) @map("profile_views")
  claimStatus                ClaimStatus        @default(claimed) @map("claim_status")
  dataSource                 DataSource         @default(self_signup) @map("data_source")
  claimToken                 String?            @unique @map("claim_token") @db.Uuid
  claimInvitationSentAt      DateTime?          @map("claim_invitation_sent_at")
  claimInvitationCount       Int                @default(0) @map("claim_invitation_count")
  outreachEmail              String?            @map("outreach_email") @db.VarChar(255)
  removalRequestedAt         DateTime?          @map("removal_requested_at")
  googlePlaceId              String?            @unique @map("google_place_id") @db.VarChar(255)
  outreachStatus             OutreachStatus     @default(not_contacted) @map("outreach_status")
  outreachUpdatedAt          DateTime?          @map("outreach_updated_at")
  outreachNotes              String?            @map("outreach_notes")

  // CBR v2.0 — Verification paywall (FEAT-001)
  setupFeePaidAt                DateTime? @map("setup_fee_paid_at")
  setupFeeAmountCents           Int?      @map("setup_fee_amount_cents")
  setupFeeStripePaymentIntentId String?   @unique @map("setup_fee_stripe_pi_id") @db.VarChar(255)
  /// When this barber claimed a Founding seat by starting checkout at the intro
  /// rate. Seats are counted as paid-or-reserved so two applicants cannot both
  /// be told they took seat 10 while sitting on Stripe's payment page.
  /// Reservations expire (see SEAT_RESERVATION_MINUTES) so an abandoned checkout
  /// releases the seat.
  setupFeeReservedAt            DateTime? @map("setup_fee_reserved_at")
  foundingMember                Boolean   @default(false) @map("founding_member")
  /// Billing plan chosen at application checkout. Annual is the default and the
  /// headline offer; monthly is the opt-out. Captured before payment so approval
  /// can provision the subscription without asking again.
  selectedPlan                  BillingPlan @default(annual) @map("selected_plan")
  /// DEPRECATED — never gated access. It was written as 2099-12-31 to mean
  /// "founding members never pay", which the one-year founding trial replaces.
  /// Access state now comes from the Stripe subscription (status + trial_end).
  /// Retained only so existing rows are not silently dropped.
  subscriptionWaivedUntil       DateTime? @map("subscription_waived_until")

  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation("BarberToUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy            User?                  @relation("VerifiedBy", fields: [verifiedByUserId], references: [id])
  specialties           BarberSpecialty[]
  contactRequests       ContactRequest[]
  favorites             Favorite[]
  portfolioImages       PortfolioImage[]
  reviews               Review[]
  services              Service[]
  suspensionReason      SuspensionReason?      @map("suspension_reason")
  suspendedAt           DateTime?              @map("suspended_at")
  suspendedByUserId     String?                @map("suspended_by_user_id") @db.Uuid
  subscription          Subscription?
  suspendedBy           User?                  @relation("SuspendedBy", fields: [suspendedByUserId], references: [id])
  appeals               SuspensionAppeal[]
  serviceAreas          ServiceArea[]
  travelDates           TravelDate[]
  socialPostGenerations SocialPostGeneration[]
  referralsReceived     Referral[]             @relation("ReferralsReceived")
  referralsPerformed    Referral[]             @relation("ReferralsPerformed")
  referralPayouts       ReferralPayout[]
  outreachNoteEntries   OutreachNote[]

  @@index([userId])
  @@index([slug])
  @@index([city])
  @@index([state])
  @@index([zipCode])
  @@index([verificationStatus])
  @@index([isFeatured])
  @@index([averageRating])
  @@index([verificationStatus, averageRating]) // Composite for approved + sorted queries
  @@index([verificationStatus, city, state]) // Composite for location-based search
  @@index([claimStatus])
  @@index([outreachStatus])
  @@map("barber_profiles")
}

model OutreachNote {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  authorId  String?       @map("author_id") @db.Uuid
  body      String
  createdAt DateTime      @default(now()) @map("created_at")
  profile   BarberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([createdAt])
  @@map("outreach_note_entries")
}

model Specialty {
  id      Int               @id @default(autoincrement())
  name    String            @unique @db.VarChar(100)
  slug    String            @unique @db.VarChar(100)
  icon    String?           @db.VarChar(50)
  barbers BarberSpecialty[]

  @@map("specialties")
}

model BarberSpecialty {
  barberProfileId String        @map("barber_profile_id") @db.Uuid
  specialtyId     Int           @map("specialty_id")
  barberProfile   BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  specialty       Specialty     @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([barberProfileId, specialtyId])
  @@map("barber_specialties")
}

model Service {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId String        @map("barber_profile_id") @db.Uuid
  name            String        @db.VarChar(150)
  description     String?
  priceCents      Int           @map("price_cents")
  durationMinutes Int           @map("duration_minutes")
  isActive        Boolean       @default(true) @map("is_active")
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  barberProfile   BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@index([barberProfileId])
  @@map("services")
}

model PortfolioImage {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId String        @map("barber_profile_id") @db.Uuid
  imageUrl        String        @map("image_url")
  thumbnailUrl    String?       @map("thumbnail_url")
  caption         String?       @db.VarChar(255)
  sortOrder       Int           @default(0) @map("sort_order")
  createdAt       DateTime      @default(now()) @map("created_at")
  barberProfile   BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@index([barberProfileId])
  @@map("portfolio_images")
}

model Review {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId String          @map("barber_profile_id") @db.Uuid
  clientUserId    String?         @map("client_user_id") @db.Uuid
  rating          Int
  title           String?         @db.VarChar(200)
  comment         String?
  isVerified      Boolean         @default(false) @map("is_verified")
  isVisible       Boolean         @default(true) @map("is_visible")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  barberProfile   BarberProfile   @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  client          User?           @relation(fields: [clientUserId], references: [id])
  response        ReviewResponse?

  @@unique([barberProfileId, clientUserId])
  @@index([barberProfileId])
  @@index([clientUserId])
  @@index([rating])
  @@index([barberProfileId, isVisible]) // Composite for public reviews query
  @@map("reviews")
}

model Favorite {
  clientUserId    String        @map("client_user_id") @db.Uuid
  barberProfileId String        @map("barber_profile_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  barberProfile   BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  client          User          @relation(fields: [clientUserId], references: [id], onDelete: Cascade)

  @@id([clientUserId, barberProfileId])
  @@map("favorites")
}

model ContactRequest {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId   String               @map("barber_profile_id") @db.Uuid
  clientUserId      String?              @map("client_user_id") @db.Uuid
  clientName        String               @map("client_name") @db.VarChar(200)
  clientEmail       String               @map("client_email") @db.VarChar(255)
  clientPhone       String?              @map("client_phone") @db.VarChar(20)
  message           String
  serviceInterested String?              @map("service_interested") @db.VarChar(200)
  preferredDate     DateTime?            @map("preferred_date") @db.Date
  preferredTime     String?              @map("preferred_time")
  status            ContactRequestStatus @default(new)
  createdAt         DateTime             @default(now()) @map("created_at")
  barberProfile     BarberProfile        @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  client            User?                @relation(fields: [clientUserId], references: [id])

  @@index([barberProfileId])
  @@index([status])
  @@map("contact_requests")
}

model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id") @db.Uuid
  details     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")
  actor       User?    @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_log")
}

model ReviewResponse {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewId  String   @unique @map("review_id") @db.Uuid
  comment   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_responses")
}

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId      String             @unique @map("barber_profile_id") @db.Uuid
  stripeCustomerId     String             @unique @map("stripe_customer_id") @db.VarChar(255)
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id") @db.VarChar(255)
  stripePriceId        String?            @map("stripe_price_id") @db.VarChar(255)
  tier                 SubscriptionTier   @default(starter)
  status               SubscriptionStatus @default(active)
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  trialEndsAt          DateTime?          @map("trial_ends_at")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?          @map("canceled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")
  barberProfile        BarberProfile      @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([status])
  @@map("subscriptions")
}

model SuspensionAppeal {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId  String           @map("barber_profile_id") @db.Uuid
  reason           SuspensionReason
  appealText       String           @map("appeal_text")
  status           AppealStatus     @default(pending)
  adminNotes       String?          @map("admin_notes")
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  barberProfile    BarberProfile    @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)
  reviewedBy       User?            @relation("AppealReviewedBy", fields: [reviewedByUserId], references: [id])

  @@index([barberProfileId])
  @@index([status])
  @@map("suspension_appeals")
}

enum UserRole {
  barber
  client
  admin
  hnwi
}

enum BlackLabelLeadStatus {
  new
  contacted
  converted
  declined
}

model BlackLabelLead {
  id               String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName         String               @map("full_name") @db.VarChar(120)
  email            String               @db.VarChar(254)
  city             String?              @db.VarChar(120)
  source           String?              @db.VarChar(120)
  notes            String?
  status           BlackLabelLeadStatus @default(new)
  adminNotes       String?              @map("admin_notes")
  reviewedAt       DateTime?            @map("reviewed_at")
  reviewedByUserId String?              @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("black_label_leads")
}

enum VerificationStatus {
  pending
  approved
  rejected
  suspended
  expired
}

enum ClaimStatus {
  unclaimed
  claim_sent
  claimed
}

enum DataSource {
  self_signup
  manual_admin
  google_places
  state_license
}

enum OutreachStatus {
  not_contacted
  messaged_ig
  messaged_fb
  messaged_tiktok
  messaged_email
  messaged_phone
  responded
  not_interested
  bounced
}

enum ContactRequestStatus {
  new
  read
  responded
  archived
}

/// Which cadence a barber picked at application checkout.
enum BillingPlan {
  annual
  monthly
}

enum SubscriptionTier {
  starter
  professional
  elite
  verified
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  unpaid
}

model SocialPhoto {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  imageUrl  String   @map("image_url")
  label     String   @db.VarChar(200)
  keywords  Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("social_photos")
}

model SocialPostGeneration {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId String        @map("barber_profile_id") @db.Uuid
  templateType    String        @map("template_type") @db.VarChar(50)
  platform        String        @db.VarChar(50)
  createdAt       DateTime      @default(now()) @map("created_at")
  barberProfile   BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@index([barberProfileId])
  @@index([barberProfileId, createdAt])
  @@map("social_post_generations")
}

model ServiceArea {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId String        @map("barber_profile_id") @db.Uuid
  city            String        @db.VarChar(100)
  state           String        @db.VarChar(2)
  notes           String?       @db.VarChar(255)
  createdAt       DateTime      @default(now()) @map("created_at")
  barberProfile   BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@unique([barberProfileId, city, state])
  @@index([city, state])
  @@index([barberProfileId])
  @@map("service_areas")
}

model TravelDate {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberProfileId String        @map("barber_profile_id") @db.Uuid
  city            String        @db.VarChar(100)
  state           String        @db.VarChar(2)
  startDate       DateTime      @map("start_date") @db.Date
  endDate         DateTime      @map("end_date") @db.Date
  notes           String?       @db.VarChar(500)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  barberProfile   BarberProfile @relation(fields: [barberProfileId], references: [id], onDelete: Cascade)

  @@index([city, state, startDate, endDate])
  @@index([barberProfileId])
  @@index([endDate])
  @@map("travel_dates")
}

enum SuspensionReason {
  fraudulent_documentation
  expired_license
  policy_violation
  client_complaints
  payment_fraud
  legal_regulatory
}

enum AppealStatus {
  pending
  approved
  denied
}

enum BlogCategory {
  for_clients @map("for-clients")
  for_barbers @map("for-barbers")
  industry
}

enum BlogStatus {
  draft
  published
}

model BlogPost {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String       @unique @db.VarChar(200)
  title       String       @db.VarChar(200)
  description String       @db.VarChar(500)
  content     String       @db.Text
  keywords    Json         @default("[]")
  category    BlogCategory
  status      BlogStatus   @default(draft)
  readingTime Int          @default(5) @map("reading_time")
  author      String       @default("Concierge Barber Registry") @db.VarChar(200)
  imageUrl    String?      @map("image_url")
  imageAlt    String?      @map("image_alt") @db.VarChar(300)
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([category, status])
  @@index([publishedAt])
  @@index([status])
  @@map("blog_posts")
}

// ─── CBR v2.0 — Referral & royalty ledger (FEAT-003) ──────────────────────────
//
// Honor-system v1: the *performing* barber (the one in the new city who served
// the traveling client) submits a referral, crediting the *referring* barber
// (the client's home barber) with a 10% royalty. Admin reviews, approves, and
// batches monthly payouts. CBR doesn't process bookings, so no automated
// service-complete trigger — the performing barber self-reports.

enum ReferralStatus {
  pending
  approved
  paid
  disputed
  declined
}

model Referral {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referringBarberId   String         @map("referring_barber_id") @db.Uuid
  performingBarberId  String         @map("performing_barber_id") @db.Uuid
  clientFirstName     String?        @map("client_first_name") @db.VarChar(100)
  clientCity          String?        @map("client_city") @db.VarChar(100)
  serviceDescription  String         @map("service_description")
  serviceFeeCents     Int            @map("service_fee_cents")
  payoutCents         Int            @map("payout_cents")
  platformCutCents    Int            @map("platform_cut_cents")
  status              ReferralStatus @default(pending)
  adminNotes          String?        @map("admin_notes")
  disputeReason       String?        @map("dispute_reason")
  submittedAt         DateTime       @default(now()) @map("submitted_at")
  approvedAt          DateTime?      @map("approved_at")
  approvedByUserId    String?        @map("approved_by_user_id") @db.Uuid
  paidAt              DateTime?      @map("paid_at")
  payoutId            String?        @map("payout_id") @db.Uuid

  referringBarber   BarberProfile   @relation("ReferralsReceived", fields: [referringBarberId], references: [id], onDelete: Cascade)
  performingBarber  BarberProfile   @relation("ReferralsPerformed", fields: [performingBarberId], references: [id], onDelete: Cascade)
  payout            ReferralPayout? @relation(fields: [payoutId], references: [id])

  @@index([referringBarberId])
  @@index([performingBarberId])
  @@index([status])
  @@index([submittedAt])
  @@index([payoutId])
  @@map("referrals")
}

model ReferralPayout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  barberId  String   @map("barber_id") @db.Uuid
  totalCents Int     @map("total_cents")
  batchRef  String?  @map("batch_ref") @db.VarChar(120)
  notes     String?
  paidAt    DateTime @default(now()) @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")

  barber    BarberProfile @relation(fields: [barberId], references: [id], onDelete: Cascade)
  referrals Referral[]

  @@index([barberId])
  @@index([batchRef])
  @@index([paidAt])
  @@map("referral_payouts")
}

// ─── CBR v2.0 — Grooming Passport (FEAT-002) ──────────────────────────────────
//
// Encrypted vault of a client's technical grooming specs (guard sizes, density,
// products, allergies, notes). Encrypted at rest via AES-256-GCM with a
// platform-managed key — keyVersion supports rotation. The client owns their
// passport; barbers only see it via short-lived single-use share tokens that
// the client mints (typically as a QR code shown at the chair).

model GroomingPassport {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clientUserId   String   @unique @map("client_user_id") @db.Uuid
  encryptedSpecs Bytes    @map("encrypted_specs")
  keyVersion     Int      @default(1) @map("key_version")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  client User                  @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  shares PassportShareToken[]

  @@map("grooming_passports")
}

model PassportShareToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  passportId     String    @map("passport_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt      DateTime  @map("expires_at")
  redeemedAt     DateTime? @map("redeemed_at")
  redeemedByUserId String? @map("redeemed_by_user_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")

  passport GroomingPassport @relation(fields: [passportId], references: [id], onDelete: Cascade)

  @@index([passportId])
  @@index([expiresAt])
  @@map("passport_share_tokens")
}
